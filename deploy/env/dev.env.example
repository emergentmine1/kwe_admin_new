# DEV environment. Copy to your secret store / pipeline variables; never commit real values.
# Replace every <...> placeholder. Context paths are examples; change them per environment if needed.

# ---- admin-ui (Next.js) ----
# BASE_PATH is fixed at build time: build one image per environment (docker build --build-arg BASE_PATH=...).
BASE_PATH=/rqms
AUTH_MODE=okta
SESSION_SECRET=<random string, 32+ characters, different per environment>
APP_PUBLIC_URL=https://<dev-admin-host>
BACKEND_URL=https://<dev-api-host>/rqms-api
OKTA_ISSUER=https://<okta-domain>/oauth2/<auth-server-id>
OKTA_CLIENT_ID=<okta web app client id>
OKTA_CLIENT_SECRET=<okta web app client secret>
OKTA_IDP_ID=<entra id idp id, optional>
OKTA_SCOPES=openid profile email

# ---- backend-java (Spring Boot) ----
SERVER_CONTEXT_PATH=/rqms-api
SERVER_PORT=8080
DB_HOST=<aurora-dev-endpoint>
DB_PORT=5432
DB_NAME=<db name>
DB_SCHEMA=quoteownr
DB_USER=<db user>
DB_PASSWORD=<db password>
KWE_AUTH_MODE=okta
OKTA_AUDIENCE=api://default
# Browser never calls the API directly (Next.js server proxies it); keep CORS tight.
KWE_CORS_ALLOWEDORIGINPATTERNS=https://<dev-admin-host>
SWAGGER_ENABLED=false
